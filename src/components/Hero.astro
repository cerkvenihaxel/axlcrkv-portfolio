---
import { AnimatedGradientText } from './ui/animated-gradient-text';
import { Particles } from './ui/particles';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <Particles client:load />
  
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <AnimatedGradientText client:load>
      <h1 class="text-6xl md:text-8xl font-bold mb-6">
        Axel Cerkvenih
      </h1>
    </AnimatedGradientText>
    
    <p class="text-2xl md:text-3xl text-[#e5e5e5] mb-4 font-medium">
      Application Security Engineer @ <span class="text-[#00ff88]">Personal Pay</span>
    </p>
    
    <p class="text-lg md:text-xl text-[#a3a3a3] mb-8 max-w-3xl mx-auto">
      Application Security Engineer | Security-First Mindset
    </p>
    
    <p class="text-base md:text-lg text-[#a3a3a3] mb-12 max-w-2xl mx-auto">
      Building resilient digital solutions by integrating security into the heart of the development lifecycle.
      Specializing in DevSecOps, cloud hardening, and secure software architecture.
    </p>
    
    <div class="flex gap-4 justify-center flex-wrap">
      <a 
        href="#contact" 
        class="px-8 py-3 bg-[#00ff88] text-[#0a0a0a] rounded-lg font-medium hover:bg-[#00cc6a] transition-colors"
      >
        Get In Touch
      </a>
    </div>
  </div>
</section>
