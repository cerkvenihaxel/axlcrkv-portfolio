---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HeroSection } from '../components/HeroSection';
import { AboutSection } from '../components/AboutSection';
import { ServicesSection } from '../components/ServicesSection';
import TechStackMonitor from '../components/TechStackMonitor.astro';
import { TimelineSection } from '../components/TimelineSection';
import { GitHubSection } from '../components/GitHubSection';
import '../styles/global.css';
---

<BaseLayout>
  <HeroSection client:load />
  <AboutSection client:load />
  <ServicesSection client:load />
  <TechStackMonitor />
  <TimelineSection client:load />
  <GitHubSection client:load />
  
  <footer id="contact" class="py-20 px-6 border-t border-[#1a1a1a]">
    <div class="max-w-4xl mx-auto">
      <h3 class="text-4xl font-bold mb-4 text-center">
        <span data-i18n="contact.title">Get In</span> <span class="text-[#00ff88]" data-i18n="contact.titleAccent">Touch</span>
      </h3>
      <p class="text-[#a3a3a3] text-center mb-12" data-i18n="contact.subtitle">
        Interested in application security, DevSecOps, or secure software architecture?
      </p>
      
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-[#111111] border border-[#1a1a1a] rounded-lg p-6">
          <h4 class="text-xl font-semibold mb-4 text-[#e5e5e5]" data-i18n="contact.form.title">Send me a message</h4>
          <form action="mailto:cerkvenihaxel@proton.me" method="post" enctype="text/plain" class="space-y-4">
            <div>
              <label for="name" class="block text-sm text-[#a3a3a3] mb-2" data-i18n="contact.form.name">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name"
                required
                class="w-full px-4 py-2 bg-[#0a0a0a] border border-[#1a1a1a] rounded-lg text-[#e5e5e5] focus:border-[#00ff88] focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="block text-sm text-[#a3a3a3] mb-2" data-i18n="contact.form.email">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                required
                class="w-full px-4 py-2 bg-[#0a0a0a] border border-[#1a1a1a] rounded-lg text-[#e5e5e5] focus:border-[#00ff88] focus:outline-none"
              />
            </div>
            <div>
              <label for="message" class="block text-sm text-[#a3a3a3] mb-2" data-i18n="contact.form.message">Message</label>
              <textarea 
                id="message" 
                name="message"
                rows="4"
                required
                class="w-full px-4 py-2 bg-[#0a0a0a] border border-[#1a1a1a] rounded-lg text-[#e5e5e5] focus:border-[#00ff88] focus:outline-none resize-none"
              ></textarea>
            </div>
            <button 
              type="submit"
              class="w-full px-6 py-3 bg-[#00ff88] text-[#0a0a0a] rounded-lg font-medium hover:bg-[#00cc6a] transition-colors"
              data-i18n="contact.form.submit"
            >
              Send Message
            </button>
          </form>
        </div>
        
        <div class="space-y-6">
          <div class="bg-[#111111] border border-[#1a1a1a] rounded-lg p-6">
            <h4 class="text-xl font-semibold mb-4 text-[#e5e5e5]" data-i18n="contact.quick.title">Quick Contact</h4>
            <div class="space-y-4">
              <a 
                href="https://api.whatsapp.com/send/?phone=2612780455&text&type=phone_number&app_absent=0"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 px-6 py-3 bg-[#25D366] text-white rounded-lg font-medium hover:bg-[#20BA5A] transition-colors"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span data-i18n="contact.quick.whatsapp">Contact via WhatsApp</span>
              </a>
              
              <a 
                href="mailto:cerkvenihaxel@proton.me"
                class="flex items-center gap-3 px-6 py-3 border border-[#1a1a1a] rounded-lg hover:border-[#00ff88] transition-colors"
              >
                <svg class="w-6 h-6 text-[#00ff88]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                cerkvenihaxel@proton.me
              </a>
            </div>
          </div>
          
          <div class="bg-[#111111] border border-[#1a1a1a] rounded-lg p-6">
            <h4 class="text-xl font-semibold mb-4 text-[#e5e5e5]" data-i18n="contact.connect.title">Connect</h4>
            <div class="flex gap-4">
              <a 
                href="https://linkedin.com/in/axelcerkvenih" 
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-2 border border-[#1a1a1a] rounded-lg hover:border-[#00ff88] transition-colors"
              >
                LinkedIn
              </a>
              <a 
                href="https://github.com/axelcerkvenih" 
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-2 border border-[#1a1a1a] rounded-lg hover:border-[#00ff88] transition-colors"
              >
                GitHub
              </a>
              <a 
                href="/.well-known/security.txt"
                class="px-6 py-2 border border-[#1a1a1a] rounded-lg hover:border-[#00ff88] transition-colors font-mono text-sm"
              >
                security.txt
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <p class="text-[#a3a3a3] text-sm text-center">
        © 2026 Axel Cerkvenih. <span data-i18n="contact.footer">Built with security in mind.</span>
      </p>
    </div>
  </footer>
  
  <script>
    import en from '../i18n/en.json';
    import es from '../i18n/es.json';

    const translations = { en, es };

    function updateTranslations() {
      const lang = (localStorage.getItem('lang') || 'en') as 'en' | 'es';
      const t = translations[lang];
      
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (key) {
          const keys = key.split('.');
          let value: any = t;
          for (const k of keys) {
            value = value[k];
          }
          if (value) el.textContent = value;
        }
      });
    }

    updateTranslations();
    window.addEventListener('languageChange', updateTranslations);
  </script>
</BaseLayout>

